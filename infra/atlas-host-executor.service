[Unit]
Description=Atlas Host-Executor Bridge
Documentation=https://github.com/GainMarketing123/nanoclaw
After=nanoclaw.service
Wants=nanoclaw.service

[Service]
Type=simple
User=atlas
Group=atlas
# Codex d0d744d R1 F2 BLOCKING follow-up (2026-05-08): parameterize ExecStart
# via ${NANOCLAW_DIR} so the executable path tracks the same root host-executor
# resolves at runtime (IPC_DIR, messages.db, quality-check-prompt.md, etc.).
# Without this, an operator who overrides NANOCLAW_DIR via the shared env file
# would have the service still launching python from the OLD checkout while
# the running module reads runtime files from the NEW checkout — a split-brain
# mixed-version runtime where restarts keep relaunching stale code.
# WorkingDirectory keeps the literal path: systemd's WorkingDirectory= does NOT
# perform ${VAR} substitution from Environment=/EnvironmentFile= the way
# ExecStart= does (substitution there is implemented by systemd's exec layer,
# not the unit-file parser). The default path matches the default Environment=
# below; override deployments needing a different cwd should template the unit
# at deploy time. host-executor.py reads runtime paths via NANOCLAW_DIR not via
# os.getcwd(), so this remains correct as long as ATLAS_HOST_MODE=production
# enforces NANOCLAW_DIR explicitness (see lib/atlas_paths.env_or_home strict).
WorkingDirectory=/home/atlas/nanoclaw
ExecStart=/usr/bin/python3 ${NANOCLAW_DIR}/host/host-executor.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=atlas-host-executor

# Environment
Environment=HOME=/home/atlas
Environment=TZ=America/New_York
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/atlas/.local/bin
# Explicit Atlas state + Nanoclaw repo paths so future User= migrations don't
# silently re-resolve via the new user's $HOME. host-executor.py reads these
# at module load with `Path.home() / ...` defaults if unset, so deployments
# that haven't picked up the new unit (or that haven't run daemon-reload
# after the unit lands) continue to behave as before.
Environment=ATLAS_DIR=/home/atlas/.atlas
Environment=NANOCLAW_DIR=/home/atlas/nanoclaw

# Codex 30f5e5f R1 F1 + d0d744d R1 F1 BLOCKING follow-up (2026-05-08): pull
# canonical paths from a shared file that git-sync.sh ALSO sources. Without
# this, cron and systemd read independent process envs and an operator who
# sets ATLAS_DIR/NANOCLAW_DIR only here would see cron continue to use its
# own defaults — running services and the auto-sync/restart pipeline operating
# on different repos.
#
# ORDER MATTERS — codex review on cea04e4 (2026-05-08) caught the inverse:
# EnvironmentFile= MUST come AFTER the Environment= defaults above. systemd
# applies env assignments in source order and last-write-wins, so a shared
# file listed BEFORE Environment=ATLAS_DIR=/home/atlas/.atlas would be
# silently overwritten in the very override scenario this is meant to enable.
# Listing it AFTER the defaults makes /etc/atlas/atlas.env authoritative when
# present, with the per-Environment= lines as the in-tree fallback when the
# shared file is absent (leading dash on EnvironmentFile= = optional load).
EnvironmentFile=-/etc/atlas/atlas.env
# Codex 7c7401b F2 BLOCKING revert: a previous version of this file added
# Environment=CLAUDE_CONFIG_DIR=/home/nanoclaw-he/.claude here, but this
# unit still runs as User=atlas. The atlas user cannot read a 0600
# credentials file owned by nanoclaw-he, so that env line caused
# permission errors on every claude -p invocation. The CLAUDE_CONFIG_DIR=
# line BELONGS in this unit AFTER the 1.A.6 Phase 3.2 User=nanoclaw-he
# migration lands — at which point the user owning the credentials and
# the user running the service align. CEO's resume-prompt VPS-side step
# (add CLAUDE_CONFIG_DIR to the live unit's EnvironmentFile) runs in
# lockstep with the User= cutover, NOT separately. Until then, this unit
# keeps the atlas-user-readable default ($HOME/.claude under the atlas
# user) and the refresh script's relocated path applies only to the
# nanoclaw service (which already runs under the right user).
# Phase 3.0 (1.A.6): activate the production fail-closed path in
# host-executor.py — when ATLAS_HOST_MODE=production is set, missing
# ATLAS_DIR / NANOCLAW_DIR env vars become an explicit RuntimeError at
# module import instead of silently falling back to Path.home(). Without
# this, the dev-mode fallback runs in production and the User= migration
# hardening declared in the comment block at lines 23-29 is inactive.
# Round-1 codex SOFT (e0b6fe0 F3) closure.
Environment=ATLAS_HOST_MODE=production

# Minimal hardening — claude -p needs broad filesystem access for hooks
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
