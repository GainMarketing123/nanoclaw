# Mission Control HTTP Basic auth credentials. Fail-closed: if either is unset,
# the mission-control HTTP dashboard refuses to start (returns exit code 2 with
# stderr message). Set both to enable the dashboard. The historical "auth
# disabled" mode was removed because combined with the 0.0.0.0 listener it
# exposed the full dashboard and the ~/.atlas state it surfaces to every host
# that could reach MC_PORT.
MISSION_CONTROL_USER=
MISSION_CONTROL_PASS=

# IMPORTANT: This file (nanoclaw/.env) is for nanoclaw-specific config only.
# The shared secret QUALITY_CHECK_TOKEN below lives in ~/.atlas/.env on the
# VPS instead — that's the file mounted read-only into containers at
# /home/node/.atlas/.env, so the container-side response-interceptor can read
# it. Don't put QUALITY_CHECK_TOKEN here.
#
# To mint and install the token on the VPS:
#   openssl rand -hex 32
#   echo "QUALITY_CHECK_TOKEN=<value>" >> ~/.atlas/.env
#   sudo systemctl restart atlas-host-executor.service
#   ./container/build.sh   # rebuild containers so they pick up the new token
#
# Fail-closed: host-executor.py refuses to start (exit 2) if QUALITY_CHECK_TOKEN
# is unset; container-side callHaiku() treats a missing token as
# checkerUnavailable=true (audit-honest, response still flows).

# --- Health endpoint (internal-liveness probe for the atlas-watchdog) ---
# The orchestrator serves GET /health on loopback so the watchdog can detect an
# internally-wedged process (message loop stalled) that a bare `pgrep` still
# sees as alive. Returns 200 when the work loop is beating, 503 when stalled.
# Defaults: port 3003 (3001=credential proxy, 3002=bridge callback), 60s stall
# threshold. Override only if those ports clash on the host.
HEALTH_PORT=3003
HEALTH_STALL_THRESHOLD_MS=60000
# Startup grace: how long the process may sit before the message loop's first
# heartbeat before /health reports 503. Bounds the "still booting" window so a
# startup wedge (e.g. a hung channel connect) can't keep /health green forever.
HEALTH_STARTUP_GRACE_MS=120000

# --- Microsoft Teams channel (primary CEO command channel; see teams/PROVISIONING.md) ---
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
TEAMS_BOT_TENANT_ID=
TEAMS_ADAPTER_PORT=3978
# The bot is the OWNER's private Atlas — it answers ONLY this identity and
# refuses everyone else. Set at least one (aadObjectId preferred). If neither
# is set the bot refuses ALL users (fail-closed). Find the Object ID in
# Azure Portal -> Microsoft Entra ID -> Users -> (you) -> Object ID.
# Leave blank in the template: fill in YOUR own object id / UPN. A pre-filled
# value would make `setup/verify.ts` report Teams configured for the wrong
# identity while the runtime owner gate refuses your actual account.
ATLAS_OWNER_AAD_OBJECT_ID=
ATLAS_OWNER_UPN=
# Thin client to the Second-Brain memory service:
SECOND_BRAIN_BASE_URL=http://127.0.0.1:8000
SECOND_BRAIN_API_KEY=
